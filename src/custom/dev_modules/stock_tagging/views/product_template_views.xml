<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Hereda la vista lista base de productos para agregar x_operation_tag_ids
         después de la columna uom_id (visible en Inventario > Lista de Productos).
    ================================================================ -->

    <record id="product_template_list_view_stock_tagging" model="ir.ui.view">
        <field name="name">product.template.list.stock.tagging</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="uom_id" position="after">
                <field
                    name="x_operation_tag_ids"
                    widget="many2many_tags"
                    options="{'color_field': 'color'}"
                    optional="show"
                    string="Etiquetas Operativas"/>
            </field>
        </field>
    </record>

</odoo>
