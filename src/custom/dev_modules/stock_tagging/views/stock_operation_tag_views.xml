<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Vistas para stock.operation.tag
    ================================================================ -->

    <!-- Vista Lista -->
    <record id="stock_operation_tag_view_list" model="ir.ui.view">
        <field name="name">stock.operation.tag.list</field>
        <field name="model">stock.operation.tag</field>
        <field name="arch" type="xml">
            <tree string="Etiquetas Operativas">
                <field name="name"/>
                <field name="operation_type"/>
                <field name="color" widget="color_picker"/>
                <field name="description"/>
            </tree>
        </field>
    </record>

    <!-- Vista Formulario -->
    <record id="stock_operation_tag_view_form" model="ir.ui.view">
        <field name="name">stock.operation.tag.form</field>
        <field name="model">stock.operation.tag</field>
        <field name="arch" type="xml">
            <form string="Etiqueta Operativa">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="operation_type"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                    <separator string="Descripción"/>
                    <field name="description" nolabel="1" placeholder="Ingrese una descripción de la etiqueta..."/>
                    <separator string="Productos Relacionados"/>
                    <field name="product_template_ids" nolabel="1">
                        <tree>
                            <field name="name" string="Nombre" optional="show"/>
                            <field name="default_code" string="Referencia" optional="show"/>
                            <field name="categ_id" string="Categoría" optional="show"/>
                            <field name="qty_available" string="Cant. Disponible" optional="show"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción para stock.operation.tag -->
    <record id="action_stock_operation_tag" model="ir.actions.act_window">
        <field name="name">Etiquetas Operativas</field>
        <field name="res_model">stock.operation.tag</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primera etiqueta operativa
            </p>
            <p>
                Las etiquetas operativas permiten clasificar productos
                según el tipo de operación de inventario.
            </p>
        </field>
    </record>

    <!-- ================================================================
         Vista Kanban para product.template agrupada por x_operation_tag_ids
    ================================================================ -->

    <record id="product_template_view_kanban_by_tag" model="ir.ui.view">
        <field name="name">product.template.kanban.by.tag</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <kanban default_group_by="x_operation_tag_ids" class="o_kanban_small_column">
                <field name="name"/>
                <field name="priority"/>
                <field name="x_operation_tag_ids"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <div class="o_kanban_record_top_right">
                                    <field name="priority" widget="priority"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="x_operation_tag_ids"
                                           widget="many2many_tags"
                                           options="{'color_field': 'color'}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Acción: Productos por Etiqueta Operativa (Kanban + lista) -->
    <record id="action_product_by_operation_tag" model="ir.actions.act_window">
        <field name="name">Productos por Etiqueta Operativa</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,tree</field>
        <field name="view_id" ref="product_template_view_kanban_by_tag"/>
        <field name="context">{"group_by": "x_operation_tag_ids"}</field>
        <field name="domain">[("type", "in", ["product", "consu"])]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay productos con etiquetas operativas
            </p>
            <p>
                Asigna etiquetas operativas a tus productos para
                verlos organizados aquí.
            </p>
        </field>
    </record>

    <!-- ================================================================
         Elementos de Menú
    ================================================================ -->

    <!-- Configuración de etiquetas en Inventario > Configuración -->
    <menuitem
        id="menu_stock_operation_tag_config"
        name="Etiquetas Operativas"
        parent="stock.menu_stock_config_settings"
        action="action_stock_operation_tag"
        sequence="50"/>

    <!-- Productos por etiqueta en Inventario (menú raíz) -->
    <menuitem
        id="menu_product_by_operation_tag"
        name="Etiquetas Operativas"
        parent="stock.menu_stock_inventory_control"
        action="action_product_by_operation_tag"
        sequence="30"/>

</odoo>
