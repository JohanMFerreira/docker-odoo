<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_cron_check_reordering" model="ir.cron">
        <field name="name">Stock Priority: Check Reordering Levels</field>
        <!-- model_id debe referenciar el registro ir.model de product.template -->
        <field name="model_id" ref="product.model_product_template"/>
        <field name="state">code</field>
        <field name="code">model.action_check_reordering()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="priority">10</field>
    </record>

</odoo>
