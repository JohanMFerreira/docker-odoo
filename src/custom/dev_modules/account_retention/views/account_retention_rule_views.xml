<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista Lista -->
    <record id="view_account_retention_rule_list" model="ir.ui.view">
        <field name="name">account.retention.rule.list</field>
        <field name="model">account.retention.rule</field>
        <field name="arch" type="xml">
            <tree string="Reglas de Retención">
                <field name="name"/>
                <field name="fiscal_profile"/>
                <field name="retention_rate" string="Tasa (%)"/>
                <field name="account_id"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Vista Formulario -->
    <record id="view_account_retention_rule_form" model="ir.ui.view">
        <field name="name">account.retention.rule.form</field>
        <field name="model">account.retention.rule</field>
        <field name="arch" type="xml">
            <form string="Regla de Retención">
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre de la regla..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Configuración">
                            <field name="fiscal_profile"/>
                            <field name="retention_rate"
                                   widget="percentage"
                                   string="Tasa de Retención (%)"/>
                            <field name="account_id"/>
                        </group>
                        <group string="Estado">
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_account_retention_rule" model="ir.actions.act_window">
        <field name="name">Reglas de Retención</field>
        <field name="res_model">account.retention.rule</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primera regla de retención
            </p>
            <p>
                Las reglas de retención definen el porcentaje y la cuenta contable
                que se utilizarán al validar facturas según el perfil fiscal del partner.
            </p>
        </field>
    </record>

    <!-- Elemento de menú en Contabilidad > Configuración -->
    <menuitem
        id="menu_account_retention_rule"
        name="Reglas de Retención"
        parent="account.menu_finance_configuration"
        action="action_account_retention_rule"
        sequence="50"/>

</odoo>
