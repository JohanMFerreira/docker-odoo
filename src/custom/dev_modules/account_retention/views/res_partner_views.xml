<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_fiscal_profile" model="ir.ui.view">
        <field name="name">res.partner.form.fiscal.profile</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Añadir perfil fiscal en la pestaña de ventas y compras -->
            <xpath expr="//page[@name='sales_purchases']//group[1]" position="inside">
                <field name="x_fiscal_profile" string="Perfil Fiscal"/>
            </xpath>
        </field>
    </record>

</odoo>
